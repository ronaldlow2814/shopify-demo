{% doc %}
  @prompt
    Create a dynamic promo banner with all content and styling editable by a non-technical merchant in the theme editor. Define schema controls for a heading, a text field, a colour setting, a collection picker, and a range slider controlling vertical padding. Render those controls end to end, including the selected collection as a linked call to action, and use the selected colour as the banner background with a readable foreground. Every visitor-facing default, fallback, and CTA string must use a literal translation filter key with corresponding locale entries, rather than hardcoded text; merchant-entered content must remain editable and render from its settings. Translate schema labels through schema locale keys too. Use semantic markup and responsive layout that works at 375px without overflow. Conditionally render the heading, text, and collection link only when populated; omit empty wrappers and omit the banner container entirely when there is no content. Keep all requested controls available in the generated block's schema so the merchant can edit it entirely in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign banner_heading = block.settings.heading | strip %}
{% assign banner_text = block.settings.promo_text | strip %}
{% assign banner_collection = block.settings.collection %}
{% if banner_heading != blank or banner_text != blank or banner_collection != blank %}
  {% style %}
    .ai-promo-banner-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      box-sizing: border-box;
      padding: {{ block.settings.vertical_padding }}px clamp(16px, 4vw, 40px);
      background: {{ block.settings.banner_color }};
      color: #000000;
    }
    .ai-promo-banner-{{ ai_gen_id }} .ai-promo-banner__inner-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      max-width: 1200px;
      margin: 0 auto;
    }
    .ai-promo-banner-{{ ai_gen_id }} .ai-promo-banner__content-{{ ai_gen_id }} { min-width: 0; }
    .ai-promo-banner-{{ ai_gen_id }} .ai-promo-banner__heading-{{ ai_gen_id }} {
      margin: 0 0 6px;
      color: #000000;
      font-size: clamp(20px, 3vw, 30px);
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
    .ai-promo-banner-{{ ai_gen_id }} .ai-promo-banner__text-{{ ai_gen_id }} {
      margin: 0;
      color: #000000;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }
    .ai-promo-banner-{{ ai_gen_id }} .ai-promo-banner__link-{{ ai_gen_id }} {
      display: inline-flex;
      flex: 0 1 auto;
      align-items: center;
      justify-content: center;
      max-width: 100%;
      padding: 11px 18px;
      border: 1px solid #000000;
      border-radius: 2px;
      color: #000000;
      font-weight: 600;
      text-align: center;
      text-decoration: underline;
      text-underline-offset: 3px;
      overflow-wrap: anywhere;
    }
    .ai-promo-banner-{{ ai_gen_id }} .ai-promo-banner__link-{{ ai_gen_id }}:focus-visible {
      outline: 3px solid #000000;
      outline-offset: 3px;
    }
    @media screen and (max-width: 600px) {
      .ai-promo-banner-{{ ai_gen_id }} .ai-promo-banner__inner-{{ ai_gen_id }} {
        align-items: flex-start;
        flex-direction: column;
        gap: 14px;
      }
    }
  {% endstyle %}
  <aside class="ai-promo-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }} aria-label="{{ 'blocks.promo_banner.accessible_label' | t }}">
    <div class="ai-promo-banner__inner-{{ ai_gen_id }}">
      {% if banner_heading != blank or banner_text != blank %}
        <div class="ai-promo-banner__content-{{ ai_gen_id }}">
          {% if banner_heading != blank %}<h2 class="ai-promo-banner__heading-{{ ai_gen_id }}">{{ banner_heading | escape }}</h2>{% endif %}
          {% if banner_text != blank %}<p class="ai-promo-banner__text-{{ ai_gen_id }}">{{ banner_text | escape }}</p>{% endif %}
        </div>
      {% endif %}
      {% if banner_collection != blank %}
        <a class="ai-promo-banner__link-{{ ai_gen_id }}" href="{{ banner_collection.url }}">{{ 'blocks.promo_banner.cta' | t: collection: banner_collection.title | escape }}</a>
      {% endif %}
    </div>
  </aside>
{% endif %}

{% schema %}
{
  "name": "t:blocks.promo_banner.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:blocks.promo_banner.settings.heading.label" },
    { "type": "text", "id": "promo_text", "label": "t:blocks.promo_banner.settings.text.label" },
    { "type": "color", "id": "banner_color", "label": "t:blocks.promo_banner.settings.color.label", "default": "#45c0b6" },
    { "type": "collection", "id": "collection", "label": "t:blocks.promo_banner.settings.collection.label" },
    { "type": "range", "id": "vertical_padding", "label": "t:blocks.promo_banner.settings.vertical_padding.label", "min": 8, "max": 64, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "desktop_width_percent", "label": "t:blocks.promo_banner.settings.desktop_width.label", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "t:blocks.promo_banner.name" }],
  "tag": null,
  "class": "promo-banner-block"
}
{% endschema %}